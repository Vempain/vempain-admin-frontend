{
  "name": "@vempain/vempain-admin-frontend",
  "version": "0.9.0",
  "description": "Vempain Admin frontend",
  "author": "Paul-Erik Törrönen",
  "homepage": "https://vempain.poltsi.fi",
  "license": "GPL-2.0",
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "prebuild": "node generateBuildInfo.js",
    "prestart": "node generateBuildInfo.js",
    "start": "env-cmd -f .env.local vite",
    "start-combined": "env-cmd -f .env.combined vite --port 4000",
    "build": "yarn prebuild && tsc -b && env-cmd -f .env.prod vite build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage .",
    "test:debug": "jest --inspect-brk --runInBand --no-cache",
    "preview": "vite preview",
    "build:production": "yarn prebuild && env-cmd -f .env.prod vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix"
  },
  "dependencies": {
    "@ant-design/charts": "^2.6.7",
    "@ant-design/icons": "^6.3.4",
    "@vempain/vempain-auth-frontend" : "^2.4.0",
    "@vempain/vempain-common-frontend" : "^1.1.0",
    "@vempain/vempain-rt-editor": "1.0.31",
    "antd" : "^6.7.0",
    "axios" : "^1.21.1",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.17",
    "i18next" : "^27.1.1",
    "leaflet": "^1.9.4",
    "rc-virtual-list": "^3.19.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-highlight-words": "^1.0.0",
    "react-i18next" : "^18.0.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.5",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event" : "^14.6.9",
    "@types/dompurify": "^3.2.0",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-highlight-words": "^0.20.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react" : "^6.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "env-cmd": "^11.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "typescript-eslint" : "^8.72.2",
    "vite" : "^8.3.8"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vempain/vempain-admin-frontend.git"
  }
}
