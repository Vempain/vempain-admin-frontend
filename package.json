{
  "name" : "@vempain/vempain-admin-frontend",
  "version" : "0.9.0",
  "description" : "Vempain Admin frontend",
  "author" : "Paul-Erik Törrönen",
  "homepage" : "https://vempain.poltsi.fi",
  "license" : "GPL-2.0",
  "type" : "module",
  "packageManager" : "yarn@4.18.0",
  "scripts" : {
    "prebuild" : "node generateBuildInfo.js",
    "prestart" : "node generateBuildInfo.js",
    "start" : "env-cmd -f .env.local vite",
    "start-combined" : "env-cmd -f .env.combined vite --port 4000",
    "build" : "yarn prebuild && tsc && env-cmd -f .env.prod vite build",
    "test" : "jest",
    "test:watch" : "jest --watch",
    "test:coverage" : "jest --coverage .",
    "test:debug" : "jest --inspect-brk --runInBand --no-cache",
    "preview" : "vite preview",
    "build:production" : "yarn prebuild && env-cmd -f .env.prod vite build",
    "lint" : "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix" : "eslint . --ext ts,tsx --fix"
  },
  "dependencies" : {
    "@ant-design/icons" : "^6.3.2",
    "@vempain/vempain-auth-frontend" : "^1.0.20",
    "@vempain/vempain-rt-editor" : "1.0.12",
    "antd" : "^6.5.3",
    "axios" : "^1.19.0",
    "dayjs" : "^1.11.21",
    "dompurify" : "^3.4.12",
    "rc-virtual-list" : "^3.19.2",
    "react" : "^19.2.8",
    "react-dom" : "^19.2.8",
    "react-highlight-words" : "^0.21.0",
    "react-router-dom" : "^7.18.2",
    "web-vitals" : "^6.0.1"
  },
  "devDependencies" : {
    "@eslint/js" : "^10.0.1",
    "@testing-library/dom" : "^10.4.1",
    "@testing-library/jest-dom" : "^7.0.0",
    "@testing-library/react" : "^16.3.2",
    "@testing-library/user-event" : "^14.6.1",
    "@types/dompurify" : "^3.2.0",
    "@types/jest" : "^30.0.0",
    "@types/node" : "^26.1.2",
    "@types/react" : "^19.2.18",
    "@types/react-dom" : "^19.2.4",
    "@types/react-highlight-words" : "^0.20.1",
    "@typescript/native" : "npm:typescript@^7.0.2",
    "@vitejs/plugin-react" : "^6.0.5",
    "@vitejs/plugin-react-swc" : "^4.3.3",
    "env-cmd" : "^11.0.0",
    "eslint" : "^10.8.0",
    "eslint-plugin-react-hooks" : "^7.1.1",
    "eslint-plugin-react-refresh" : "^0.5.3",
    "globals" : "^17.8.0",
    "jest" : "^30.4.2",
    "jest-environment-jsdom" : "^30.4.1",
    "ts-jest" : "^29.4.12",
    "typescript" : "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint" : "^8.65.0",
    "vite" : "^8.2.0"
  },
  "browserslist" : {
    "production" : [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development" : [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "repository" : {
    "type" : "git",
    "url" : "git+https://github.com/Vempain/vempain-admin-frontend.git"
  }
}
